{
  "name": "@usefillo/react",
  "version": "0.19.0",
  "description": "Headless React components for embedding Fillo forms natively in your product.",
  "license": "MIT",
  "keywords": [
    "forms",
    "form-builder",
    "react",
    "headless",
    "embed",
    "typescript",
    "react-forms",
    "nextjs",
    "surveys",
    "file-upload"
  ],
  "homepage": "https://fillo.so",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobfunch/usefillo.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.unlayered.css": "./dist/styles.unlayered.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../react/scripts/build-css.mjs --src src/styles.css --out dist",
    "dev": "tsup --watch --onSuccess 'cp src/styles.css dist/styles.css'",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.type-tests.json --noEmit",
    "prepublishOnly": "node -e \"require('fs').accessSync('dist/index.js');require('fs').accessSync('dist/styles.css');require('fs').accessSync('dist/styles.unlayered.css')\"",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@usefillo/core": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "axe-core": "^4.10.0",
    "react": "^19.1.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "jsdom": "^25.0.1",
    "react-dom": "^19.0.0"
  }
}
